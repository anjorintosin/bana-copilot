{
  "name": "@meeting-copilot/desktop",
  "productName": "Bana Copilot",
  "version": "0.1.1",
  "private": true,
  "description": "Bana Copilot — interview overlay",
  "author": "Bana Copilot",
  "homepage": "https://github.com/anjorintosin/bana-copilot-releases",
  "main": "dist/main.js",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/dev.mjs",
    "pack": "node scripts/build.mjs && electron-builder --publish never",
    "release": "node scripts/build.mjs && electron-builder --publish always"
  },
  "dependencies": {
    "@meeting-copilot/types": "0.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "electron": "^39.2.7",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.12",
    "typescript": "^5.8.3"
  },
  "build": {
    "appId": "com.banacopilot.desktop",
    "productName": "Bana Copilot",
    "files": [
      "dist/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "publish": null,
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "identity": null,
      "artifactName": "Bana.Copilot-${version}-${arch}.${ext}",
      "category": "public.app-category.productivity",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Bana Copilot uses the microphone to transcribe the conversation in real time.",
        "NSCameraUsageDescription": "Camera access is unused; this string is required by some capture prompts.",
        "NSAudioCaptureUsageDescription": "Bana Copilot captures meeting audio you authorize."
      }
    },
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "Bana.Copilot-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "shortcutName": "Bana Copilot"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office",
      "maintainer": "Bana Copilot",
      "artifactName": "Bana.Copilot-${version}-${arch}.${ext}"
    }
  }
}
